# Copy to nac/.env and fill in. nac/.env is gitignored — never commit real values.

# RapidAPI key issued by the Nokia NaC developer portal.
# The SDK's default environment is https://network-as-code.p-eu.rapidapi.com,
# so this is a RapidAPI key, not a bare Nokia token.
NAC_API_KEY=

# Simulator MSISDNs allocated to the account, comma-separated, E.164 with leading '+'.
# For Nabd these are the sentinels: one per monitored cell, in grid order. The
# sandbox allocates a handful rather than a city's worth, so a live run proves the
# contract on those few cells and the simulator stages the disaster on the full grid.
# Three is enough for a meaningful contract run; more is better.
NAC_MSISDNS=

# Where the account answers. The SDK's own default environment is
# network-as-code.p-eu.rapidapi.com; a console-issued developer account is served
# from apihub, and the console's playground shows both in its cURL snippet. Leave
# these blank unless yours differs — the defaults are what the console hands out.
NAC_BASE_URL=
NAC_RAPIDAPI_HOST=

# Public webhook base URL (ngrok or a small cloud host). Geofencing and QoD status
# callbacks cannot reach localhost. Leave blank until a tunnel is up — the probes
# that need it will skip and say so rather than fail.
NAC_WEBHOOK_BASE=

# Seconds to wait on one call before recording it as no reading (default 10).
# NAC_TIMEOUT_S=10
