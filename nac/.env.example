# Copy to nac/.env and fill in. nac/.env is gitignored — never commit real values.

# RapidAPI key issued by the Nokia NaC developer portal.
# The SDK's default environment is https://network-as-code.p-eu.rapidapi.com,
# so this is a RapidAPI key, not a bare Nokia token.
NAC_API_KEY=

# Simulator MSISDNs allocated to the account, comma-separated, E.164 with leading '+'.
# The first entry is treated as the airframe; the rest are stationed ground-team scouts.
# Verification item 03 measures how many of these actually answer.
NAC_MSISDNS=

# Public webhook base URL (ngrok or a small cloud host). Geofencing and QoD status
# callbacks cannot reach localhost. Leave blank until a tunnel is up — the probes
# that need it will skip and say so rather than fail.
NAC_WEBHOOK_BASE=
